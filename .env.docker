# Local Docker Compose Postgres defaults (committed — dev only).
# Loaded via: docker compose --env-file .env.docker up -d

# Privileged superuser (migrations / drizzle-kit)
POSTGRES_DB=starter
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres_dev_password
# Host port published to localhost. Container always listens on 5432.
# Use 5432 if another Postgres already owns 5432.
POSTGRES_PORT=5432

# Runtime app role (Hyperdrive / Worker localConnectionString)
# NOBYPASSRLS — created by scripts/postgres/create-app-role.sh on first boot
APP_DB_USER=starter_app
APP_DB_PASSWORD=starter_app_dev_password
