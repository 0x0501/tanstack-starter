# —————————————————— App config ————————————————————
APP_ORIGIN=http://localhost:3000
# Use http://localhost:3000 in the browser, not 127.0.0.1 (cookie/origin pitfall).
# Public site identity (document head, OG, JSON-LD). Mirrors APP_ORIGIN for the client.
VITE_APP_ORIGIN=http://localhost:3000
VITE_APP_TITLE=TanStack Starter

# —————————————————— Better Auth ————————————————————
BETTER_AUTH_URL=http://localhost:3000
# Dev-only placeholder so `cp .env.example .env && bun run dev` boots on a fresh
# clone. `bun run validate-prod-env` refuses it, so a deploy cannot inherit it.
# Real secret: `bunx --bun @better-auth/cli secret`
BETTER_AUTH_SECRET=dev-only-insecure-secret-change-before-deploy
# Optional comma-separated OAuth resource audiences (defaults to APP_ORIGIN).
BETTER_AUTH_AUDIENCES=

# —————————————————— Database ——————————————————————
# Local Docker defaults match `.env.docker` (bun run db:up).
#
# Privileged superuser — drizzle-kit migrate / push / seed only.
# Never point the Worker runtime at this URL.
DATABASE_MIGRATION_URL=postgresql://postgres:postgres_dev_password@localhost:5432/starter
#
# Runtime app role (same as wrangler.jsonc hyperdrive.localConnectionString):
# postgresql://starter_app:starter_app_dev_password@localhost:5432/starter
#
# Optional overrides for `bun run db:seed` (defaults are local-only).
# SEED_ADMIN_EMAIL=admin@localhost.dev
# SEED_ADMIN_PASSWORD=AdminPass1!
# SEED_ADMIN_NAME=Local Admin
# SEED_ADMIN_ROLE=superadmin
# SEED_USER_EMAIL=user@localhost.dev
# SEED_USER_PASSWORD=UserPass1!
# SEED_USER_NAME=Local User
# SEED_FORCE=1

# —————————————————— GitHub social (optional) ——————
# All three must be set together for GitHub to work end-to-end:
#   - VITE_GITHUB_CLIENT_ID: public client id (UI button + server fallback)
#   - GITHUB_CLIENT_ID: optional alias; if set, must match VITE_GITHUB_CLIENT_ID
#   - GITHUB_CLIENT_SECRET: server-only secret
# Client IDs are public by OAuth design. Leave all blank to hide GitHub in the UI.
VITE_GITHUB_CLIENT_ID=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# —————————————————— Turnstile —————————————————————
TURNSTILE_SECRET_KEY=
# Public site key. Leave blank in dev to disable captcha (CAPTCHA_ENABLED=false).
VITE_TURNSTILE_SITE_KEY=

# —————————————————— Email ————————————————————————
# Technical From address (domain must be verified in Cloudflare Email).
EMAIL_FROM=no-reply@example.com
# Inbox display name (clone-time brand).
EMAIL_FROM_NAME=Starter

# —————————————————— Payments (optional) ——————————
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=
CREEM_PRODUCT_ID=
CREEM_TEST_MODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NOW_PAYMENTS_API_KEY=
NOW_PAYMENTS_IPN_KEY=
NOW_PAYMENTS_TEST_MODE=false
